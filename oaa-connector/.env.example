# Veza credentials
# Get API key from: Your Veza instance > Administration > API Keys > Add New
VEZA_URL=https://your-veza-instance.vezacloud.com
VEZA_API_KEY=your-veza-api-key-here

# ServiceNow credentials
# Use your Personal Developer Instance (PDI) or demo instance
SN_INSTANCE=https://devXXXXX.service-now.com
SN_USER=your-sn-username
SN_PASSWORD=your-sn-password-here
